# StockLens AI — Environment Variables
# Copy this file to .env.local and fill in the values

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Get your keys at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/stocklens

# ─── Redis ────────────────────────────────────────────────────────────────────
# Upstash Redis (recommended for Vercel)
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Market Data ──────────────────────────────────────────────────────────────
# Provider: "yahoo" | "upstox" | "mock" (default: "yahoo")
MARKET_DATA_PROVIDER=mock

# Upstox (optional — for production NSE/BSE data)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StockLens AI

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to enable features
NEXT_PUBLIC_ENABLE_AI=false
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_ALERTS=false
